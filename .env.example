# Database (matches docker-compose.yml)
DATABASE_URL="postgresql://bonita:bonita@localhost:5432/bonita"

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-to-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# File storage: "local" (development) or "s3" (production / MinIO)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="bonita-documents"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_FORCE_PATH_STYLE="true"

# Upload limit in bytes (default 10 MB)
MAX_UPLOAD_BYTES="10485760"

# Secret used to sign short-lived download tokens
DOWNLOAD_SIGNING_SECRET="change-me-too"

# Current privacy policy version recorded with consents
POLICY_VERSION="2026-09"

# Secret for the reminders endpoint (POST /api/cron/reminders with "Authorization: Bearer <secret>")
CRON_SECRET="change-me-cron-secret"
